setwd("~/PROGRAMMING/R studio/GMM_etc_with_Hayashi_data")
dataForGMM = read_xls('ch04/greene.xls')
Z = dataForGMM %>% mutate('s1' = PL*LABOR / TC,'s2' = PK*CAPITAL / TC, 'log(p1/p3)' = log(PL/PF),
'log(p2/p3)'=log(PK/PF),'con'=1,'logQ'=log(Q/1000)) %>%
select(s1, s2,con, 'log(p1/p3)', 'log(p2/p3)', logQ)
library(tidyverse)
library(lmtest)
library(car)
library(AER)
library(plm)
library(zoo)
library(stargazer)
library(broom)
library(dynlm)
library(lubridate)
library(forecast)
library(ARDL)
library(cragg)
library(gmm)
library(orcutt)
library(sandwich)
library(gplots)
library(tidyverse)
library(readxl)
dataForGMM = read_xls('ch04/greene.xls')
Z = dataForGMM %>% mutate('s1' = PL*LABOR / TC,'s2' = PK*CAPITAL / TC, 'log(p1/p3)' = log(PL/PF),
'log(p2/p3)'=log(PK/PF),'con'=1,'logQ'=log(Q/1000)) %>%
select(s1, s2,con, 'log(p1/p3)', 'log(p2/p3)', logQ)
z01 = Z %>% select(con, 'log(p1/p3)', 'log(p2/p3)', logQ) %>% mutate(v1 = 0,v2=0,v3=0)
z02 = z01 %>% select(con, v1, 'log(p1/p3)', 'log(p2/p3)',v2, logQ, v3)
zI = z02
zII = z01 %>% select(v1, con,v2, 'log(p1/p3)', 'log(p2/p3)',v3, logQ)
X = z01[,1:4]
Z.arg = as.matrix(cbind(zI,zII))
X.arg = as.matrix(cbind(X,X))
Y.arg = as.matrix(c(Z$s1,Z$s2),ncol=1)
l = c(7,7)
k = c(4,4)
W = diag(8)
source('GMM_Est.R')
###############################################################
GMM.step01 = GMM_Est(Y.arg, X.arg, Z.arg, k, l, W, r=1)
Weight = GMM.step01[2][[1]]
dist.va = 1
while(dist.va > .001){
tem = GMM_Est(Y.arg, X.arg, Z.arg, k, l, Weight, r=1)
tem.w = tem[2][[1]]
dist.va = norm(Weight - tem.w)
Weight = tem.w
}
tem
summary(dataForGMM)
tem
View(X)
